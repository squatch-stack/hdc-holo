.venv/
__pycache__/
.pytest_cache/
.DS_Store
# data/ holds real captures and is not tracked -- except the two small
# crops every lane opens on, which are cut from their parents by
# `crop_scene_file` and are genuine SUBSETS of a real capture, so a lane
# can run its first pass on real data at d=2048 on a laptop. The rule is
# `data/*` rather than `data/`: git does not descend into an excluded
# directory, so a negation inside one never fires.
data/*
!data/fixtures/
.venv/
__pycache__/
hdc_holo.egg-info/
gpubench/
gpu*-*/
claims/index/
.claude/settings.local.json
quality/codegraph*
# generated submission bundle (paper/make_arxiv_bundle.py); the rest
# of out/ is committed evidence figures
out/arxiv/
# run telemetry: local, and every heavy run writes one
out/runs/
paper/main.pdf
paper/main.log
